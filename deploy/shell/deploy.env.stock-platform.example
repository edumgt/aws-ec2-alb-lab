# ─────────────────────────────────────────────
# 주식투자 플랫폼 백엔드 → ECS Fargate (Stage 4) 배포 환경변수
#   cp deploy/shell/deploy.env.stock-platform.example .env.deploy
#   set -a && source .env.deploy && set +a && bash deploy/shell/deploy_ecs_cli.sh
#   자세한 절차: ECS/005_stock_platform_fargate.md
# ─────────────────────────────────────────────
AWS_REGION=ap-northeast-2
# AWS_ACCOUNT_ID=            # 비우면 sts 로 자동 조회

ECS_CLUSTER=stock-trade-cluster
ECS_SERVICE=stock-trade-backend
TASK_FAMILY=stock-trade-backend

ECR_REPO=stock-coin-trade-python-backend
CONTAINER_NAME=backend
APP_DIR=../stock-coin-trade          # python-backend Dockerfile 이 있는 컨텍스트
CONTAINER_PORT=5000

CPU=512
MEMORY=1024

# EXECUTION_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/ecsTaskExecutionRole
# TASK_ROLE_ARN=arn:aws:iam::<ACCOUNT_ID>:role/stock-trade-task-role
IMAGE_TAG=latest

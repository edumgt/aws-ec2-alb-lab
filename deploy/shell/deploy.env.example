# ─────────────────────────────────────────────
# ECS Fargate 배포 환경변수 (deploy_ecs_cli.sh / Ansible 공용)
# cp deploy/shell/deploy.env.example .env.deploy
# set -a && source .env.deploy && set +a
# ─────────────────────────────────────────────

# AWS 기본 설정
AWS_REGION=ap-northeast-2
AWS_ACCOUNT_ID=086015456585

# ECS 클러스터 / 서비스 설정
ECS_CLUSTER=study-fargate-cluster
ECS_SERVICE=be-fastapi-service
TASK_FAMILY=be-fastapi-task

# ECR 리포지토리 (be-test 또는 fe-test)
ECR_REPO=be-test
CONTAINER_NAME=be-fastapi
APP_DIR=./BE-fastapi

# 컨테이너 포트
CONTAINER_PORT=8000

# Fargate 컴퓨팅 리소스
CPU=256
MEMORY=512

# IAM Role ARN (ecsTaskExecutionRole)
EXECUTION_ROLE_ARN=arn:aws:iam::086015456585:role/ecsTaskExecutionRole
# TASK_ROLE_ARN=arn:aws:iam::086015456585:role/yourTaskRole

# 이미지 태그 (미설정 시 latest 또는 타임스탬프)
IMAGE_TAG=latest
